rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /repair-attachments/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /repair-response-attachments/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }
    match /boleto-receipts/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }
    function isAdminUser() {
      return request.auth != null && (
        request.auth.token.email == 'brunoferreiramarques@gmail.com' ||
        request.auth.token.email == 'raphaelmonteirodasilva@yahoo.com.br'
      );
    }

    match /sale-contracts/{allPaths=**} {
      allow read, write: if false;
    }
    match /engineering-reports/{allPaths=**} {
      allow read: if isAdminUser();
      allow write: if isAdminUser() && request.resource.size < 15 * 1024 * 1024;
    }
    match /property-dossiers/{allPaths=**} {
      allow read: if isAdminUser();
      allow write: if isAdminUser() && request.resource.size < 15 * 1024 * 1024;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

